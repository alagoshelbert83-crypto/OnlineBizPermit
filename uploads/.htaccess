Options -Indexes
php_flag engine off
<FilesMatch \.ph(p[0-9]?|t|tml)$>
	Deny from all
</FilesMatch>

# Force correct MIME types for images (safe)
# Avoid using Header directives here because some servers do not have mod_headers enabled.
# Use AddType (requires mod_mime, which is normally enabled) and wrap in <IfModule> to be safe.
<IfModule mod_mime.c>
	AddType image/jpeg .jpg .jpeg
	AddType image/png .png
	AddType image/gif .gif
</IfModule>
